        "jsCode": "// Broken model output -> answer_failed. Anything else (quota, outage, bad key) -> api_error.\nconst error = $json.error;\nconst message = typeof error === 'string' ? error : error?.message ?? JSON.stringify(error ?? '');\nconst brokenOutput = /required format|output parser|failed to parse|empty response/i.test(message);\nreturn {\n  json: {\n    ...$('Collect matches').item.json,\n    reason: brokenOutput ? 'answer_failed' : 'api_error',\n    error: message,\n  },\n};"
