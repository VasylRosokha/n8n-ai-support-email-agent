    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// A new message in a thread the agent already handled is a follow-up, not a new conversation.\nconst email = $('Prepare emails').item.json;\nconst earlier = ($json.messages ?? []).filter((message) => message.id !== email.message_id);\nconst threadHas = (label) => earlier.some((message) => (message.labelIds ?? []).includes(email.labels[label]));\n\nlet threadStatus = 'new';\nif (threadHas('needs-human')) {\n  threadStatus = 'human_owned';\n} else if (threadHas('ai-replied')) {\n  threadStatus = 'follow_up';\n}\n\nreturn { json: { ...email, thread_status: threadStatus } };"
      },
