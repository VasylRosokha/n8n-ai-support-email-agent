    {
      "parameters": {
        "jsCode": "// Keeps the knowledge base matches with their scores. The best score decides\n// whether the knowledge base covers the question at all.\n// A working search always returns matches; when Pinecone or the embedding model fails,\n// n8n passes the email through unchanged instead, so no matches means the search failed.\nconst email = $('Add classification').first().json;\nconst matches = $input.all()\n  .filter(({ json }) => json.document)\n  .map(({ json }) => ({\n    source: json.document.metadata?.source ?? '',\n    section: json.document.metadata?.section ?? '',\n    score: Number(json.score.toFixed(3)),\n    text: json.document.pageContent,\n  }))\n  .sort((a, b) => b.score - a.score);\n\nif (matches.length === 0) {\n  return [{\n    json: {\n      ...email,\n      matches,\n      top_score: 0,\n      reason: 'api_error',\n      error: 'Knowledge base search failed (Pinecone or Gemini embeddings). See the n8n execution for details.',\n    },\n  }];\n}\n\nreturn [{ json: { ...email, matches, top_score: matches[0].score } }];"
      },
      "id": "e624a04c-c858-5a1c-be26-f114ef3572ec",
      "name": "Collect matches",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
