    {
      "parameters": {
        "jsCode": "// One clean item per new email: sender, subject, cleaned body and the Gmail label ids.\n// Also decides whether to skip it before any AI call (own address, reply to an alert, automated sender, bulk mail).\nconst config = $('Config').first().json;\nconst labels = Object.fromEntries($input.all().map((label) => [label.json.name, label.json.id]));\n\nconst REQUIRED_LABELS = ['ai-processed', 'ai-replied', 'not-support', 'needs-human', 'ai-skipped'];\nconst missing = REQUIRED_LABELS.filter((name) => !labels[name]);\nif (missing.length) {\n  throw new Error(`Create these Gmail labels first: ${missing.join(', ')}`);\n}\n\nconst AUTOMATED_SENDER = /(^|[._+-])(no-?reply|do-?not-?reply|mailer-daemon|postmaster|bounces?|notifications?)([._+-]|@)/i;\nconst MAX_BODY_CHARS = 4000;\n\nconst htmlToText = (html) =>\n  html\n    .replace(/<div class=\"gmail_quote[\\s\\S]*$/i, '')\n    .replace(/<(style|script)[\\s\\S]*?<\\/\\1>/gi, '')\n    .replace(/<br\\s*\\/?>/gi, '\\n')\n    .replace(/<\\/(p|div|li|tr|h[1-6])>/gi, '\\n')\n    .replace(/<[^>]+>/g, '')\n    .replace(/&nbsp;/g, ' ')\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')\n    .replace(/&quot;/g, '\"')\n    .replace(/&#39;/g, \"'\")\n    .replace(/&amp;/g, '&');\n\n// Drops quoted earlier messages and the signature, then limits the length.\nconst cleanBody = (text) => {\n  let body = text.replace(/\\r\\n/g, '\\n');\n  const cut = body.search(/^(On\\b[\\s\\S]{0,300}?wrote:|-{2,} ?Original Message ?-{2,}|-- ?)\\s*$/m);\n  if (cut !== -1) body = body.slice(0, cut);\n  const lines = body.split('\\n').filter((line) => !line.startsWith('>'));\n  const paragraphs = lines.join('\\n').trim().split(/\\n{2,}/);\n  // Quote headers in other languages, e.g. \"пн, 26 окт. 2026 г. в 12:07, Name <address>:\"\n  if (paragraphs.length > 1 && /@\\S*>?:\\s*$/.test(paragraphs.at(-1))) paragraphs.pop();\n  return paragraphs.join('\\n\\n').slice(0, MAX_BODY_CHARS);\n};\n\nconst header = (email, name) => {\n  const line = email.headers?.[name];\n  return line ? line.slice(line.indexOf(':') + 1).trim() : '';\n};\n\nreturn $('Gmail Trigger').all().map(({ json: email }) => {\n  const sender = email.from?.value?.[0] ?? {};\n  const fromAddress = (sender.address ?? '').toLowerCase();\n\n  let skipReason = '';\n  if (fromAddress === config.agent_email.toLowerCase()) {\n    skipReason = 'own_address';\n  } else if ((email.subject ?? '').includes('[needs-human]')) {\n    // Someone replied to one of our own alert emails\n    skipReason = 'alert_reply';\n  } else if (AUTOMATED_SENDER.test(fromAddress)) {\n    skipReason = 'automated_sender';\n  } else if (header(email, 'list-unsubscribe') || header(email, 'list-id') || /bulk|list|junk/i.test(header(email, 'precedence'))) {\n    skipReason = 'bulk_mail';\n  }\n\n  return {\n    json: {\n      message_id: email.id,\n      thread_id: email.threadId,\n      from_address: fromAddress,\n      from_name: sender.name ?? '',\n      subject: email.subject || '(no subject)',\n      body: cleanBody(email.text || htmlToText(email.html || '')),\n      received_at: email.date,\n      skip_reason: skipReason,\n      labels,\n    },\n  };\n});"
      },
