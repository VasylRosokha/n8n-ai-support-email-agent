        "jsCode": "// Broken model output -> classification_failed. Anything else (quota, outage, bad key) -> api_error.\nconst error = $json.error;\nconst message = typeof error === 'string' ? error : error?.message ?? JSON.stringify(error ?? '');\nconst brokenOutput = /required format|output parser|failed to parse|empty response/i.test(message);\nreturn {\n  json: {\n    ...$('Check follow-up').item.json,\n    reason: brokenOutput ? 'classification_failed' : 'api_error',\n    error: message,\n  },\n};"
      },
