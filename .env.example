# Copy to .env and fill in. Never commit .env.
# API keys (Gmail, Gemini, Pinecone, Telegram) go into n8n credentials, not here.

GENERIC_TIMEZONE=Europe/Prague
TZ=Europe/Prague

# Encrypts the credentials n8n stores. Generate with: openssl rand -hex 32
# Losing it means re-entering every credential.
N8N_ENCRYPTION_KEY=change-me
